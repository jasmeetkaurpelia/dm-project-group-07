     for col in ["bikes_in", "bikes_out", "bikes_total"]:
         if col in out.columns:
             out[col] = pd.to_numeric(out[col], errors="coerce").astype(float)
         else:
             out[col] = None
 
     for col in ["is_outage", "is_zero", "is_outlier"]:
         if col in out.columns:
             out[col] = out[col].fillna(False).astype(bool)
