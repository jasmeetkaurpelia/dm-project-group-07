         "bikes_in": prep_decimal(),
         "bikes_out": prep_decimal(),
         "bikes_total": prep_decimal(),
         "is_outage": prep_bool(),
         "is_zero": prep_bool(),
         "is_outlier": prep_bool(),
     })
