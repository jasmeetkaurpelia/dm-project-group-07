 # Fallback stubs for Tableau Prep injected schema helpers (Clears Pylance Warnings)
 # ---------------------------------------------------------------------------
 if "prep_string" not in globals():
     def prep_string(): return "string"
     def prep_date(): return "date"
     def prep_datetime(): return "datetime"
     def prep_decimal(): return "decimal"
     def prep_int(): return "int"
     def prep_bool(): return "bool"
 
 
 # ---------------------------------------------------------------------------
 # Tableau Prep Step Function (Rules B7 & B8)
 # ---------------------------------------------------------------------------
 def flag_rules(df: pd.DataFrame) -> pd.DataFrame:
     """
     Executes Rule B7 (Outage and Outlier flagging) on the incoming Tableau Prep stream.
     """
     # 1. Flag zero/outage days and statistical outliers
     out, _ = c.flag_outages.raw(df)
     out, _ = c.flag_outliers.raw(out)
 
     # 2. Cast data types to match Tableau Prep's schema
     out["site_id"] = out["site_id"].astype(str)
     out["date"] = pd.to_datetime(out["date"]).dt.date
     out["bikes_in"] = pd.to_numeric(out["bikes_in"], errors="coerce")
     out["bikes_out"] = pd.to_numeric(out["bikes_out"], errors="coerce")
     out["bikes_total"] = pd.to_numeric(out["bikes_total"], errors="coerce")
     out["is_outage"] = out["is_outage"].astype(bool)
     out["is_zero"] = out["is_zero"].astype(bool)
     out["is_outlier"] = out["is_outlier"].astype(bool)
 
     # 3. Restrict output to the exact columns defined in get_output_schema()
     schema_cols = [
         "site_id",
         "date",
         "bikes_in",
         "bikes_out",
         "bikes_total",
         "is_outage",
         "is_zero",
         "is_outlier",
     ]
     return out[schema_cols]
 
 
 # ---------------------------------------------------------------------------
 # Output Schema
 # ---------------------------------------------------------------------------
 def get_output_schema():
     """
     Defines the exact schema returned back to Tableau Prep Builder.
     """
     return pd.DataFrame({
         "site_id": prep_string(),
         "date": prep_date(),
         "bikes_in": prep_decimal(),
         "bikes_out": prep_decimal(),
         "bikes_total": prep_decimal(),
         "is_outage": prep_bool(),
         "is_zero": prep_bool(),
         "is_outlier": prep_bool(),
     })
